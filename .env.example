# پورت اجرای وب‌سرور و پل بک‌اند تندیس (پیش‌فرض: 3000)
PORT=3000

# آدرس API نسخه یک سرور مرکزی Django تندیس
# روی خود سرور اصلی مقدار زیر را روی http://127.0.0.1:8000/api/v1/ بگذارید
TANDIS_DJANGO_BASE_URL=http://127.0.0.1:8000/api/v1/

# شناسه مرچنت کد ۳۶ رقمی زرین‌پال (پس از تایید درگاه شاپرکی در پنل زرین‌پال وارد کنید)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# آدرس دامنه عمومی برای آدرس بازگشت درگاه پرداخت (مثلاً https://tandiis.com)
PUBLIC_BASE_URL=https://tandiis.com

